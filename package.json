{
    "name": "antigravity-workflow-kit",
    "displayName": "Antigravity Workflow Kit",
    "description": "Auto-accept file edits and terminal commands in Antigravity. Zero-click AI coding with Auto-All, Multi-Tab, and Autonomous Mode.",
    "version": "3.0.2",
    "publisher": "ai-dev-2024",
    "license": "MIT",
    "icon": "media/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/ai-dev-2024/antigravity-workflow-kit"
    },
    "bugs": {
        "url": "https://github.com/ai-dev-2024/antigravity-workflow-kit/issues"
    },
    "homepage": "https://github.com/ai-dev-2024/antigravity-workflow-kit",
    "sponsor": {
        "url": "https://ko-fi.com/ai_dev_2024"
    },
    "categories": [
        "Machine Learning",
        "Other"
    ],
    "keywords": [
        "ai",
        "antigravity",
        "autonomous",
        "auto-accept",
        "auto-all",
        "workflow",
        "gemini",
        "claude",
        "cursor",
        "windsurf",
        "codeium",
        "automation"
    ],
    "engines": {
        "vscode": "^1.75.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "workflowKit.toggleExtension",
                "title": "Workflow Kit: Toggle Extension ON/OFF"
            },
            {
                "command": "workflowKit.toggleAutoAll",
                "title": "Workflow Kit: Toggle Auto-All Mode"
            },
            {
                "command": "workflowKit.toggleMultiTab",
                "title": "Workflow Kit: Toggle Multi-Tab Mode"
            },
            {
                "command": "workflowKit.toggleAutopilotMode",
                "title": "Workflow Kit: Toggle Autonomous Loop"
            },
            {
                "command": "workflowKit.openSettings",
                "title": "Workflow Kit: Open Dashboard"
            },
            {
                "command": "workflowKit.toggleMcp",
                "title": "Workflow Kit: Toggle MCP Server"
            },
            {
                "command": "workflowKit.toggleVoice",
                "title": "Workflow Kit: Toggle Voice Control"
            },
            {
                "command": "workflowKit.generateTests",
                "title": "Workflow Kit: Generate Tests for Current File"
            },
            {
                "command": "workflowKit.runCodeReview",
                "title": "Workflow Kit: Run Code Review"
            },
            {
                "command": "workflowKit.startMultiAgent",
                "title": "Workflow Kit: Start Multi-Agent Task"
            },
            {
                "command": "workflowKit.showMemory",
                "title": "Workflow Kit: Show Session Memory"
            },
            {
                "command": "workflowKit.syncProjectTasks",
                "title": "Workflow Kit: Sync Project Tasks (Jira/GitHub)"
            }
        ],
        "configuration": {
            "title": "Antigravity Workflow Kit",
            "properties": {
                "workflowKit.autoAllEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Auto-accept file edits and commands"
                },
                "workflowKit.multiTabEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Work across all conversation tabs"
                },
                "workflowKit.autopilotModeEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable autonomous loop with model selection"
                },
                "workflowKit.autoSwitchModels": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically switch models based on task type"
                },
                "workflowKit.autoGitCommit": {
                    "type": "boolean",
                    "default": false,
                    "description": "Auto-commit progress every 10 loops"
                },
                "workflowKit.preferredModelForReasoning": {
                    "type": "string",
                    "default": "claude-opus-4.5-thinking",
                    "enum": [
                        "claude-opus-4.5-thinking",
                        "claude-sonnet-4.5-thinking",
                        "claude-sonnet-4.5"
                    ],
                    "description": "Model for complex reasoning tasks"
                },
                "workflowKit.preferredModelForFrontend": {
                    "type": "string",
                    "default": "gemini-3-pro-high",
                    "enum": [
                        "gemini-3-pro-high",
                        "gemini-3-pro-low",
                        "gemini-3-flash"
                    ],
                    "description": "Model for frontend/UI tasks"
                },
                "workflowKit.preferredModelForQuick": {
                    "type": "string",
                    "default": "gemini-3-flash",
                    "enum": [
                        "gemini-3-flash",
                        "gemini-3-pro-low",
                        "gpt-oss-120b"
                    ],
                    "description": "Model for quick tasks"
                },
                "workflowKit.loopInterval": {
                    "type": "number",
                    "default": 30,
                    "minimum": 10,
                    "maximum": 120,
                    "description": "Seconds between autonomous loop iterations"
                },
                "workflowKit.maxLoopsPerSession": {
                    "type": "number",
                    "default": 100,
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "Maximum loops before pausing"
                },
                "workflowKit.pollFrequency": {
                    "type": "number",
                    "default": 1000,
                    "minimum": 500,
                    "maximum": 5000,
                    "description": "Auto-All polling frequency in ms"
                },
                "workflowKit.bannedCommands": {
                    "type": "array",
                    "default": [
                        "rm -rf /",
                        "rm -rf ~",
                        "format c:",
                        "del /f /s /q"
                    ],
                    "description": "Commands to block from auto-execution"
                },
                "workflowKit.maxCallsPerHour": {
                    "type": "number",
                    "default": 100,
                    "minimum": 10,
                    "maximum": 500,
                    "description": "Maximum API calls per hour (rate limiting)"
                },
                "workflowKit.executionTimeout": {
                    "type": "number",
                    "default": 15,
                    "minimum": 1,
                    "maximum": 60,
                    "description": "Minutes before timeout per loop execution"
                },
                "workflowKit.maxConsecutiveTestLoops": {
                    "type": "number",
                    "default": 3,
                    "minimum": 1,
                    "maximum": 10,
                    "description": "Exit after this many consecutive test-only loops"
                }
            }
        }
    },
    "scripts": {
        "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
        "watch": "npm run compile -- --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "vscode:prepublish": "npm run compile",
        "package": "npx @vscode/vsce package --allow-missing-repository"
    },
    "dependencies": {
        "ws": "^8.13.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/vscode": "^1.75.0",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "@vitest/coverage-v8": "^4.0.16",
        "@vscode/vsce": "^2.22.0",
        "esbuild": "^0.27.1",
        "eslint": "^8.55.0",
        "typescript": "^5.3.0",
        "vitest": "^4.0.16"
    }
}